# Supabase project config (public — safe to expose to the browser).
# Naming follows @supabase/ssr conventions for Next.js App Router projects.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Base URL of the NestJS API (apps/api), including its /v1 global prefix.
# Server-only: never exposed to the browser. The BFF fetch helper
# (src/lib/api/server-fetch.ts) reads the caller's Supabase session on the
# server and forwards it as a bearer token to this URL.
# Required in production: a missing value throws there instead of silently
# falling back to the localhost default below.
API_BASE_URL=http://127.0.0.1:3001/v1

# Absolute site origin used to build the OAuth redirect URL. Set it in
# production: when set it always wins over the request's Host header. Leave
# it unset locally (and on preview deploys) to derive the origin from Host.
# x-forwarded-host is never trusted (src/features/auth/auth-actions.ts).
# NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
