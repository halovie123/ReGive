{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "contracts:build": "corepack pnpm --filter @buy-nothing/contracts build",
    "prebuild": "corepack pnpm run contracts:build",
    "build": "nest build",
    "predev": "corepack pnpm run contracts:build",
    "dev": "nest start --watch",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prestart": "corepack pnpm run contracts:build",
    "start": "nest start",
    "prestart:dev": "corepack pnpm run contracts:build",
    "start:dev": "nest start --watch",
    "prestart:debug": "corepack pnpm run contracts:build",
    "start:debug": "nest start --debug --watch",
    "prestart:prod": "corepack pnpm run contracts:build",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "pretest": "corepack pnpm run contracts:build",
    "test": "jest --runInBand && jest --config ./test/jest-e2e.json --runInBand",
    "pretest:watch": "corepack pnpm run contracts:build",
    "test:watch": "jest --watch",
    "pretest:cov": "corepack pnpm run contracts:build",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "pretest:e2e": "corepack pnpm run contracts:build",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "pretest:e2e:db": "corepack pnpm run contracts:build",
    "test:e2e:db": "jest --config ./test/jest-e2e.json --runInBand test/identity-db.e2e-spec.ts test/profiles-db.e2e-spec.ts",
    "pretest:e2e:profiles-db": "corepack pnpm run contracts:build",
    "test:e2e:profiles-db": "jest --config ./test/jest-e2e.json --runInBand test/profiles-db.e2e-spec.ts",
    "pretypecheck": "corepack pnpm run contracts:build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@buy-nothing/contracts": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "jose": "^6.2.8",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.3",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^7.9.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
