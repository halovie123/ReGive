{
  "rootDir": "../../..",
  "roots": ["<rootDir>/apps/api/test"],
  "moduleFileExtensions": ["js", "json", "ts"],
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      { "tsconfig": "<rootDir>/apps/api/tsconfig.spec.json" }
    ]
  }
}
