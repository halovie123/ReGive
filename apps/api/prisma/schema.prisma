generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@map("user_status")
}

enum AppRole {
  DONOR
  RECIPIENT
  VOLUNTEER

  @@map("app_role")
}

enum AreaCode {
  QUAN_1
  QUAN_3
  QUAN_4
  QUAN_5
  QUAN_6
  QUAN_7
  QUAN_8
  QUAN_10
  QUAN_11
  QUAN_12
  THU_DUC
  BINH_THANH
  GO_VAP
  PHU_NHUAN
  TAN_BINH
  TAN_PHU
  BINH_TAN
  HOC_MON
  CU_CHI
  BINH_CHANH
  NHA_BE
  CAN_GIO

  @@map("area_code")
}

model User {
  id                        String           @id @default(uuid()) @db.Uuid
  providerSubject           String           @unique @map("provider_subject")
  encryptedPhone            String?          @map("encrypted_phone")
  phoneLast4                String?          @map("phone_last4") @db.VarChar(4)
  phoneVerifiedAt           DateTime?        @map("phone_verified_at") @db.Timestamptz(3)
  phoneEncryptionKeyVersion Int?             @map("phone_encryption_key_version")
  status                    UserStatus       @default(ACTIVE)
  activeRole                AppRole?         @map("active_role")
  createdAt                 DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  roleAssignments           RoleAssignment[]
  profile                   Profile?
  areaAssignments           UserArea[]

  @@index([status])
  @@map("users")
}

model RoleAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      AppRole
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
  @@map("user_role_assignments")
}

model Area {
  code      AreaCode @id
  nameVi    String   @map("name_vi")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  userAreas UserArea[]

  @@index([active])
  @@map("areas")
}

model Profile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  displayName String   @map("display_name") @db.VarChar(80)
  bio         String   @default("") @db.VarChar(300)
  avatarKey   String?  @map("avatar_key")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model UserArea {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  areaCode  AreaCode @map("area_code")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  area      Area     @relation(fields: [areaCode], references: [code], onDelete: Restrict)

  @@unique([userId, areaCode])
  @@index([areaCode])
  @@map("user_areas")
}
