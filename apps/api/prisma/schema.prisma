generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@map("user_status")
}

enum AppRole {
  DONOR
  RECIPIENT
  VOLUNTEER

  @@map("app_role")
}

enum AreaCode {
  QUAN_1
  QUAN_3
  QUAN_4
  QUAN_5
  QUAN_6
  QUAN_7
  QUAN_8
  QUAN_10
  QUAN_11
  QUAN_12
  THU_DUC
  BINH_THANH
  GO_VAP
  PHU_NHUAN
  TAN_BINH
  TAN_PHU
  BINH_TAN
  HOC_MON
  CU_CHI
  BINH_CHANH
  NHA_BE
  CAN_GIO

  @@map("area_code")
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  RESERVED
  COMPLETED
  WITHDRAWN
  EXPIRED
  MODERATION_HIDDEN

  @@map("listing_status")
}

enum ItemCategory {
  HOUSEHOLD
  CLOTHING
  BOOKS
  CHILDREN
  DEVICES

  @@map("item_category")
}

enum ItemCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR

  @@map("item_condition")
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH

  @@map("risk_level")
}

/// Sign-in is Google/Facebook OAuth only. The four phone columns
/// (encrypted_phone, phone_last4, phone_verified_at,
/// phone_encryption_key_version) were dropped by
/// 20260906000000_drop_phone_verification once phone/OTP sign-in was
/// removed; they had never held a value.
model User {
  id              String           @id @default(uuid()) @db.Uuid
  providerSubject String           @unique @map("provider_subject")
  status          UserStatus       @default(ACTIVE)
  activeRole      AppRole?         @map("active_role")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  roleAssignments RoleAssignment[]
  profile         Profile?
  areaAssignments UserArea[]
  listings        Listing[]

  @@index([status])
  @@map("users")
}

model RoleAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      AppRole
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
  @@map("user_role_assignments")
}

model Area {
  code      AreaCode   @id
  nameVi    String     @map("name_vi")
  active    Boolean    @default(true)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  userAreas UserArea[]
  listings  Listing[]

  @@index([active])
  @@map("areas")
}

model Profile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  displayName String   @map("display_name") @db.VarChar(80)
  bio         String   @default("") @db.VarChar(300)
  avatarKey   String?  @map("avatar_key")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model UserArea {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  areaCode  AreaCode @map("area_code")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  area      Area     @relation(fields: [areaCode], references: [code], onDelete: Restrict)

  @@unique([userId, areaCode])
  @@index([areaCode])
  @@map("user_areas")
}

/// Carries an area, never an address or coordinates (spec: public listings
/// show only the AreaCode). Visibility is status = PUBLISHED and expiresAt in
/// the future -- there is no background job to mark EXPIRED on the free
/// tier, so read paths must check expiresAt themselves.
model Listing {
  id              String                  @id @default(uuid()) @db.Uuid
  ownerId         String                  @map("owner_id") @db.Uuid
  title           String                  @db.VarChar(100)
  description     String                  @db.VarChar(2000)
  defects         String                  @default("") @db.VarChar(800)
  /// toSearchText(title + description), written by the API. Full-text indexed
  /// by an expression GIN index in the listing_search migration.
  searchText      String                  @default("") @map("search_text")
  category        ItemCategory
  condition       ItemCondition
  areaCode        AreaCode                @map("area_code")
  status          ListingStatus           @default(DRAFT)
  publishedAt     DateTime?               @map("published_at") @db.Timestamptz(3)
  expiresAt       DateTime?               @map("expires_at") @db.Timestamptz(3)
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner           User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  area            Area                    @relation(fields: [areaCode], references: [code], onDelete: Restrict)
  riskAssessments ListingRiskAssessment[]

  @@index([ownerId, createdAt])
  @@index([status, publishedAt])
  @@index([status, areaCode, publishedAt])
  @@index([status, category, publishedAt])
  @@index([category])
  @@index([areaCode])
  @@map("listings")
}

/// One row per automatic screening (listing-risk.ts), kept as history: the
/// moderation queue (Plan 5) needs to show why a listing was held or hidden,
/// including after the owner edits it. reasons holds RiskReason codes.
model ListingRiskAssessment {
  id        String    @id @default(uuid()) @db.Uuid
  listingId String    @map("listing_id") @db.Uuid
  level     RiskLevel
  reasons   String[]
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  listing   Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt])
  @@map("listing_risk_assessments")
}
